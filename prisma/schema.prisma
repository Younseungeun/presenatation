// 리서치 마켓플레이스 MVP 데이터 모델
// CLAUDE.md 기획 문서 기반. 개발용 SQLite — 운영 전환 시 provider만 postgresql로 변경.
// SQLite는 enum 미지원 → 상태값 문자열은 src/domain/constants.ts 의 상수를 단일 기준으로 사용.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 본인 인증 필수(1인 1계정), 필명 활동 허용
model User {
  id               String   @id @default(cuid())
  email            String   @unique
  penName          String? // 필명 (공개 표시명)
  identityVerified Boolean  @default(false) // 본인 인증 완료 여부
  identityHash     String?  @unique // 실명 인증 CI 해시 — 계정 재생성 세탁 차단
  /**
   * 본인 인증에서 받은 실명 (암호화 — server/fieldCrypto.ts, 2026-08-16 사용자 확정).
   * 계좌 등록 때 은행 예금주명과 대조할 상대편이다. 풀 로그인마다 갱신한다(개명 반영).
   * 화면에는 절대 노출하지 않는다 — 필명 플랫폼에서 실명이 새면 필명의 의미가 사라진다.
   */
  realNameEnc      String?
  /**
   * 세션 세대. **강제 로그아웃의 유일한 수단이다** (2026-08-16 검토 2차 Q1 보완).
   * 세션 토큰은 서명만으로 검증되는 무상태 값이라 개별 폐기가 안 된다 — 세대를 올리면
   * 그보다 낮은 세대로 서명된 토큰이 전부 한 번에 무효가 된다.
   * 기기를 지우는 것만으로는 **이미 살아 있는 세션**이 안 끊긴다. 그래서 함께 올린다.
   */
  sessionEpoch     Int      @default(0)
  role             String   @default("USER") // USER | OPERATOR — 운영자는 판정 보류 큐 수동 판정 가능
  /**
   * 콜드 운영자 계정 표시 (2026-08-16 검토 4차 Q2). 출시 초 운영자가 1명일 때
   * 2인 승인의 교착을 푸는 금고 속 두 번째 계정이다 — 실제로는 한 사람 + 두 번째 기기라,
   * **진짜 두 번째 운영자가 생기는 순간 회수해야 한다.** 남겨 두면 한 사람이 콜드를 쥐고
   * 다시 단독 승인 능력을 갖는다. 회수는 수칙이 아니라 코드가 한다 —
   * server/operatorGrantService.ts가 운영자 부여와 콜드 강등을 한 트랜잭션으로 묶는다.
   */
  operatorCold     Boolean  @default(false)
  /**
   * 운영자 생체 재확인 (2026-08-17 사용자 확정 — 1인 운영 모드).
   * 운영자가 1명일 때 2인 승인의 두 번째 사람 자리를 **실행 직전 지문·얼굴 재확인**이
   * 대신한다. 재확인은 승인서처럼 **1회용**이다 — 쓰면 비워진다.
   */
  operatorRecheckAt DateTime?
  /**
   * 재확인 표를 **생체를 통과한 그 화면에만** 준다 (2026-08-17 자체 발견 결함 수정).
   *
   * 처음엔 사용자 단위로만 찍었는데, 그러면 **훔친 세션이 창업자의 재확인에 얹혀
   * 간다** — 공격자가 다른 기기에서 세션을 쥐고 있다가 창업자가 지문을 대는 순간
   * 같이 통과하는 것이다. 그건 이 장치의 존재 이유("세션만 훔친 사람은 생체가 없어
   * 못 한다")를 정면으로 무너뜨린다.
   *
   * 그래서 재확인이 끝나면 **1회용 표(난수)를 그 응답으로만** 돌려주고, 실행 요청은
   * 그 표를 함께 보내야 한다. 표는 생체를 통과한 화면 밖으로 나가지 않는다.
   * 해시만 보관한다 — 이 칸이 새어도 표를 흉내 낼 수 없다.
   */
  operatorRecheckTokenHash String?
  /**
   * 마지막으로 종이 열쇠 비상 복구를 쓴 시각 (2026-08-17 검토 7차 Q1 보완 — 자체 발견).
   *
   * **복구로 심은 기기는 48시간 동안 돈에 못 닿는다.** 이유: 금고의 종이를 훔친 사람도
   * 복구 화면에서 *자기* 지문을 등록할 수 있고, 그러면 그 뒤의 생체 재확인은 그의
   * 지문으로 통과한다 — 관문이 통째로 그의 것이 된다. 복구 경로만 열어 두고 이 유예가
   * 없으면 "종이를 훔치면 돈이 나간다"가 되어, 백도어를 안 만들려던 설계가 물리
   * 백도어 하나로 되돌아간다.
   *
   * 48시간은 계좌 변경 쿨다운·위험 로그인 유예와 같은 근거다(본인이 알아채고 멈출 수
   * 있는 시간). 그 사이에도 **동결(돈을 막는 방향)은 누구나 할 수 있다** — 막히는 것은
   * 돈을 내보내는 쪽뿐이다.
   */
  recoveredAt      DateTime?
  createdAt        DateTime @default(now())

  researcherProfile ResearcherProfile?
  passkeys          Passkey[]
  trustedDevices    TrustedDevice[]
  purchases         Purchase[]
  cartItems         CartItem[]
  paymentIntents    PaymentIntent[]
  follows           Follow[] // 내가 팔로우한 리서처들
  pushSubscriptions PushSubscription[]
  supportTickets    SupportTicket[]
}

/// 간편 비밀번호가 사는 기기 (2026-08-16 사용자 확정 구조).
///
/// **간편 로그인은 기기에 묶인다.** 서버가 인정하는 것은 "이 기기에서 이 비밀번호"이지
/// 비밀번호 자체가 아니다 — 그래서 비밀번호가 유출돼도 다른 기기에서는 못 쓴다.
/// 새 기기는 무조건 풀 로그인(본인 인증)이고, 그것이 탈취자를 막는 구조의 뼈대다.
///
/// 기기의 정체는 풀 로그인 때 발급하는 난수 토큰(httpOnly 쿠키)이고, 여기엔 그
/// 해시만 둔다 — 이 표가 새어도 기기를 흉내 낼 수 없다.
model TrustedDevice {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 기기 쿠키 토큰의 해시 — 원문은 그 기기의 쿠키에만 있다
  deviceTokenHash String    @unique
  /// 간편 비밀번호 해시 (scrypt, salt:hash) — 6자리 숫자를 그냥 해시하면 전수조사로 뚫린다
  pinHash         String
  /// 연속 실패 수 — 상한에 닿으면 잠기고, 풀 로그인으로만 다시 연다
  failedAttempts  Int       @default(0)
  lockedAt        DateTime?
  label           String
  createdAt       DateTime  @default(now())
  lastUsedAt      DateTime?

  @@index([userId])
}

// 리서처 프로필: 등급·경력 배지·신고 여부
model ResearcherProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id])
  tier               String    @default("BRONZE") // BRONZE | SILVER | GOLD | PLATINUM | CHALLENGER
  careerBadge        String? // ANALYST | CFA | CPA | INDUSTRY_EXPERT (수동 심사 후 부여)
  // 소개말 — 리더보드 팔로우 섹션·공개 프로필의 PR 자리. 종목 언급·수익률 약속은 금지
  // (구매 전 마스킹 우회 + 투자권유 소지). 설정에서 본인이 편집한다
  bio                String?
  advisoryRegistered Boolean   @default(false) // 유사투자자문업 신고 여부 표시
  promoFeeUntil      DateTime? // 초기 입점 프로모션(수수료 10%) 만료일
  createdAt          DateTime  @default(now())

  reports       Report[]
  tierHistories TierHistory[]
  followers     Follow[] // 나를 팔로우한 사용자들
}

// 마켓 규모 스냅샷: 매시간 찍어 두는 집계값.
// 띠지의 증감(+3)은 "지금 값 − 과거 값"인데, 과거 값은 지금 조회로는 알 수 없다
// (판정·구매는 시점만 남고 "그때 몇 건이었나"는 재구성해야 하며, 검증 중 카드 수처럼
// 오르내리는 값은 아예 복원이 불가능하다). 그래서 그때그때 찍어 둔다.
model MarketSnapshot {
  id          String   @id @default(cuid())
  takenAt     DateTime @default(now())
  verifying   Int // 검증 중인 예측 카드
  judged      Int // 누적 자동 판정
  researchers Int // 게시 이력이 있는 리서처
  refundedKrw Int // 누적 현금 환불
  escrowKrw   Int // 에스크로 보관 중

  @@index([takenAt])
}

// 운영 설정: 배포 없이 운영자가 켜고 끄는 값들.
// 환경변수로 두면 바꿀 때마다 재배포가 필요해 "지금 끄고 싶다"에 대응할 수 없다.
// 값은 문자열로 저장하고 해석은 server/appSettings.ts가 맡는다 (키마다 타입이 다르다).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String? // 운영자 userId — 누가 껐는지 남는다
}

// 팔로우: 사용자 → 리서처 (단방향 구독).
// 새 예측 카드가 게시되면 팔로워에게 알림이 가고, 리더보드에서 팔로우한 리서처의
// 카드만 모아 볼 수 있다. 자기 자신(같은 계정의 리서처 프로필)은 팔로우할 수 없다.
model Follow {
  id           String            @id @default(cuid())
  followerId   String // User.id — 팔로우하는 쪽
  follower     User              @relation(fields: [followerId], references: [id])
  researcherId String // ResearcherProfile.id — 팔로우당하는 쪽
  researcher   ResearcherProfile @relation(fields: [researcherId], references: [id])
  createdAt    DateTime          @default(now())
  // 리더보드 팔로우 섹션에 고정. 팔로우가 늘면 최신순만으로는 "늘 보고 싶은 사람"이
  // 아래로 밀리므로, 본인이 직접 고정한다. 시각을 담아 고정한 순서도 유지된다
  pinnedAt     DateTime?

  @@unique([followerId, researcherId]) // 중복 팔로우 차단
  @@index([researcherId]) // 팔로워 수·알림 대상 조회
}

// 리포트: 건별 판매 단위. 리포트 1건 = 예측 카드 1건 = 판정 1건
model Report {
  id              String            @id @default(cuid())
  researcherId    String
  researcher      ResearcherProfile @relation(fields: [researcherId], references: [id])
  title           String
  summary         String // 구매 전 공개 미리보기
  content         String // 유료 본문
  priceKrw        Int // 건당 가격 (플랫폼 가이드: 5천~5만원)
  prepaymentRatio Int               @default(0) // 0 | 10 | 20 | 30 (%) — 게시 시점 고정, 변경 불가
  feeRateBp       Int? // 게시 시점 확정 총 수수료 (bp, 예: 2000 = 20%). 초안 단계엔 null
  // DRAFT | PENDING_REVIEW(컴플라이언스 검토 대기 — 판매 전) | PUBLISHED | CLOSED
  status          String            @default("DRAFT")
  // 운영자 반려 횟수. 반복 반려된 리포트를 문구만 바꿔 통과시키는 것은 규칙 탐색이므로,
  // 일정 횟수를 넘으면 검수를 통과해도 사람이 다시 본다 (compliance.ts)
  rejectionCount  Int               @default(0)
  publishedAt     DateTime?
  // 판매 마감 (판정과 무관 — 카드는 살아서 시한에 정상 판정된다).
  // 사유: WINDOW_END(시간 규칙) | BAND_EXIT(잔여 수익률이 구간 바닥×2/3 밑 종가).
  // 확정 마감은 재개하지 않는다 (domain/salesWindow.ts)
  salesClosedAt    DateTime?
  salesCloseReason String?
  createdAt       DateTime          @default(now())

  predictionCard    PredictionCard?
  purchases         Purchase[]
  cartItems         CartItem[]
  complianceReviews ComplianceReview[]
}

// 예측 카드: 게시 후 수정·삭제 불가. 철회는 가능하되 기록에 남김.
model PredictionCard {
  id            String    @id @default(cuid())
  reportId      String    @unique
  report        Report    @relation(fields: [reportId], references: [id])
  assetClass    String    @default("KR_EQUITY") // KR_EQUITY | US_EQUITY | CRYPTO
  ticker        String // 자산군별 표기: KR 6자리 코드 | US 심볼 | 업비트 마켓코드(KRW-BTC)
  currency      String    @default("KRW") // 목표가·기준가·판정가의 통화 (KRW | USD)
  assetName     String
  direction     String // UP | DOWN
  targetType    String // TARGET_PRICE(목표가 도달) | RETURN_PCT(기준가 대비 수익률)
  targetValue   Float // 목표가 또는 목표 등락률 크기(%)
  baseMode      String    @default("FIXED_AT_PUBLISH") // FIXED_AT_PUBLISH | PREV_CLOSE_AT_JUDGMENT (KR 단기: 개장 전 게시, 전일 종가를 판정 시 소급 확정)
  basePrice     Float? // 기준가. FIXED_AT_PUBLISH는 게시 시 확정, AT_JUDGMENT는 판정 시 소급 기록
  deadline      DateTime // 검증 시한
  confidence    Int       @default(5) // 신뢰도 1~10 (필수) — 점수 증폭 배율 (scoring.ts)
  selfStability Int       @default(1) // (레거시) 자기 평가 안정성 — v4에서 점수·표시 모두 제거, 과거 데이터 보존용
  // 게시 시점에 잰 종목의 실현 변동성 (최근 60거래일 로그수익률 표준편차, domain/stability.ts).
  // 안정성 별점의 원천 — 시세 조회 실패·표본 부족이면 null (별점 "—"). 점수에는 쓰지 않는다
  sigmaDaily    Float?
  // 액면분할 감지용 앵커 (domain/corporateAction.ts) — 기준가를 확정할 때 함께 적어 두는
  // "그 거래일의 종가"와 그 날짜. 과거 종가는 권리 사건이 있을 때만 바뀌므로, 같은 날짜를
  // 다시 조회해 값이 달라졌으면 그 배수가 곧 조정 배수다. 시계열이 아니라 실수 하나다
  baseCloseAnchor     Float?
  baseCloseAnchorDate String?
  // 수익성은 저장하지 않는다 — 예측 크기에서 자동 산출 (domain/profitability.ts)
  withdrawnAt   DateTime? // 철회 시각 (철회해도 기록 유지)
  createdAt     DateTime  @default(now())

  // ── 판정 이월 추적 (server/judgmentBatch) ────────────────────────────
  // 이월된 카드는 Judgment 행을 만들지 않아 다음 조회에도 **그대로 잡힌다.** 시세 소스가
  // 특정 종목에서 계속 실패하면(티커 변경·상폐 직전) 그 카드가 매 회차 KIS 호출을
  // 갉아먹고, 뒤의 멀쩡한 카드까지 느려진다. 그래서 실패할수록 뒤로 미룬다.
  deferCount    Int       @default(0)
  /** 이 시각 전에는 다시 시도하지 않는다 (지수 백오프). null이면 즉시 대상 */
  nextAttemptAt DateTime?
  /**
   * 자동 판정을 금지하고 **사람만 판정한다**.
   *
   * 판정을 되돌렸는데 원인이 **시세 소스**였다면 재판정도 같은 소스를 쓰므로 같은 오답이
   * 나온다 — 사람이 또 되돌리는 무한 반복이 된다. 그래서 되돌릴 때 사유를 물어,
   * 소스 문제면 이 플래그를 세워 자동 배치에서 빼고 운영자 판정 큐로만 보낸다.
   * 원인이 **우리 판정 로직**이었다면 세우지 않는다 — 고친 코드로 다시 매기는 것이 맞다.
   */
  manualJudgmentOnly Boolean @default(false)
  /**
   * **왜** 사람에게 왔는가 (2026-08-19 — 운영 콘솔이 두 갈래로 나누려면 필요하다).
   * 플래그만으로는 "사람이 봐야 한다"까지만 알고 **무엇을 볼지**는 모른다:
   *   CROSS_CHECK        두 소스가 서로 다른 값 → 볼 것은 **거래소 시세**
   *   IMPLAUSIBLE_QUOTE  있을 수 없는 일봉      → 볼 것은 **그 일봉 자체**
   *   REVERTED           되돌리며 사람만 판정으로 표시 → 볼 것은 **되돌린 사유**
   * null이면 시세를 못 구해 상한까지 이월된 것이다(플래그 없이 시한 경과로 큐에 온 건).
   */
  manualReason String?

  judgment Judgment?
  corporateActions CorporateActionLog[]
}

// 종목 시세 스냅샷 — 목록이 "지금 살 수 있는가"를 시세 호출 없이 답하게 하는 값.
//
// 왜 DB인가: 인메모리 캐시(server/priceCache)는 프로세스 안에서만 유효해 웹과 배치가
// 따로 부른다. 목록·상세·갱신 배치가 같은 값을 봐야 화면과 관문이 어긋나지 않는다.
//
// 왜 종목 단위인가: 같은 종목 카드가 몇 장이든 시세는 하나다. 카드 단위로 두면
// 카드 수만큼 호출이 늘어난다 (초당 1회 제한에서는 그대로 대기 시간이다).
model InstrumentQuote {
  id         String   @id @default(cuid())
  assetClass String
  ticker     String
  price      Float
  /** 이 시세를 받은 시각 — 낡으면 목록에서 숨기지 않는다 (domain/quoteWatch.ts) */
  at         DateTime
  /** 장중 갱신 대상인가 — 문턱 근처 종목만 true */
  watching   Boolean  @default(false)
  /** 이 종목 판매 중 카드들 중 가장 문턱에 가까운 q (없으면 null) */
  minQ       Float?
  /** 해제선 위에서 연속 관측된 횟수 — 한 번의 튐으로 감시가 풀리지 않게 (domain/quoteWatch.ts) */
  exitStreak Int      @default(0)
  /** 감시로 들어온 경로 — batch(일봉) | gate(결제 전 호출) | refresh(장중 갱신) */
  source     String   @default("batch")
  updatedAt  DateTime @updatedAt

  @@unique([assetClass, ticker])
  @@index([watching])
}

// 권리 사건으로 카드의 가격 기준을 옮긴 기록.
// 이미 팔린 상품의 조건(기준가·목표가)을 바꾸는 일이라 반드시 남긴다 — 구매자가
// "내가 산 목표가와 다르다"고 물었을 때 재현할 수 있어야 한다.
model CorporateActionLog {
  id               String         @id @default(cuid())
  predictionCardId String
  predictionCard   PredictionCard @relation(fields: [predictionCardId], references: [id])
  anchorDate       String // 배수를 잰 거래일 (YYYY-MM-DD)
  anchorBefore     Float // 게시 때 적어 둔 그 날의 종가
  anchorAfter      Float // 지금 다시 조회한 같은 날의 종가
  factor           Float // anchorAfter / anchorBefore
  basePriceBefore  Float
  basePriceAfter   Float
  targetBefore     Float?
  targetAfter      Float?
  applied          Boolean  @default(true) // false = 범위를 벗어나 사람 확인 대기
  // 교차검증: KIS 예탁원 권리일정에서 확인된 사건 (조회 실패·미확인이면 null)
  ksdEvent         String?
  ksdRatio         Float?
  detectedAt       DateTime @default(now())

  @@index([predictionCardId])
}

// 종목 마스터: 시세 공급자가 실제로 지원하는 종목 유니버스.
// 동기화 소스: 업비트 market/all(코인), 금융위 시세정보(국내), Twelve Data stocks(미국).
// 예측 카드는 이 안의 활성 종목만 선택 가능 → 게시되는 모든 카드의 판정 가능성이 보장된다.
model Instrument {
  id            String    @id @default(cuid())
  assetClass    String // KR_EQUITY | US_EQUITY | CRYPTO
  ticker        String // 자산군별 표기 (6자리 코드 | 심볼 | KRW-마켓코드)
  name          String // 종목명 (검색·표시용, 공급자 목록 기준)
  currency      String    @default("KRW")
  shortable     Boolean   @default(false) // 하락 예측 게시 가능 — 숏 실행 수단 존재 (코인은 전부 true)
  active        Boolean   @default(true) // 상폐·거래지원종료 시 false — 신규 게시만 차단
  // 거래소 지정 위험 등급 (domain/instrumentRisk.ts) — 자체 판단이 아니라 시장의 공식 지정을 반영
  riskLevel     String    @default("NONE") // NONE | CAUTION | WARNING | DANGER(신규 게시 차단)
  riskNote      String? // 지정 사유 (표시용)
  riskSyncedAt  DateTime? // 위험 정보 갱신 시각
  // 상장폐지 가능성 (관리종목 지정·감사의견 거절·자본잠식 등). 확정 정리매매는 riskLevel=DANGER
  delistingRisk Boolean   @default(false)
  // 시가총액 (종목 통화 기준). 과소 시총은 시세 조종·유동성 위험 → 게시 보류 대상.
  // null이면 판단하지 않는다 (공급자가 시총을 주지 않는 자산군)
  marketCap     Float?
  // 최근 실현 변동성 (일 로그수익률 표준편차) — 안정성 별점과 p₀가 함께 쓰는 값.
  // 작성 화면이 종목을 고르는 순간 필요해서 여기 캐시한다(하루 TTL). 게시 시점에는
  // 카드가 자기 값을 따로 고정한다(PredictionCard.sigmaDaily) — 게시 후 갱신되면
  // 채점 기준이 흔들리기 때문
  sigmaDaily    Float?
  sigmaSyncedAt DateTime?
  // **우리가 판정하지 못하는 종목** — riskLevel과 뜻이 다르므로 칸을 나눈다.
  // riskLevel은 **거래소가 지정한 사실**(정리매매·거래지원 종료)이고, 이쪽은
  // **우리 쪽 한계**(시세 소스가 이 티커를 못 준다)다. 처분은 둘 다 "신규 게시 차단"으로
  // 같지만 처분이 같다고 한 칸에 담으면, 나중에 시세 공급자를 갈아 끼울 때
  // "진짜 상폐된 종목"과 "우리가 못 구해서 막아 둔 종목"을 쿼리로 구분할 수 없다.
  // 값이 있으면 막힌 것이고, 그 시각이 곧 막은 때다 (`npm run risk:set --judgeable`로 해제)
  unjudgeableAt   DateTime?
  unjudgeableNote String?
  source        String // 유니버스 출처 (upbit | fsc-data.go.kr | twelvedata | seed)
  syncedAt      DateTime  @default(now())

  @@unique([assetClass, ticker])
  @@index([assetClass, name])
}

// 판정: 시장 데이터 자동 판정 결과. 판정 불가 시 무효 처리 + 전액 환불.
model Judgment {
  id                 String         @id @default(cuid())
  predictionCardId   String         @unique
  predictionCard     PredictionCard @relation(fields: [predictionCardId], references: [id])
  outcome            String // HIT | MISS | UNDECIDABLE
  undecidableReason  String? // TRADING_HALT | DELISTED | AMBIGUOUS | WITHDRAWN
  settledPrice       Float? // 판정에 사용된 시장가
  realizedReturnPct  Float? // 기준가 대비 실현 등락률(%) — 점수·트랙레코드 입력
  score              Float? // 카드 점수 (§2.2, UNDECIDABLE은 0) — 시즌·자산군별 합산의 원천
  info               Float? // 가중 전 정보량 = 로그우도비 기여분 — 규율 래더가 이것을 합산한다 (score와 달리 수익성 가중이 없다: 증거는 목표 크기에 비례하지 않는다)
  dataSource         String? // 판정 데이터 소스 식별자 (예: fsc-data.go.kr, manual)
  marketSnapshotJson String? // 판정에 사용한 원천 시세 스냅샷 (감사·분쟁 재현용, JudgmentAudit 직렬화)
  judgedAt           DateTime       @default(now())

  disputes JudgmentDispute[]
}

// 판정 이의제기 — **구매자 → 플랫폼의 단방향 클레임.**
//
// 왜 만드나: 이 창구가 없으면 "판정이 틀렸다"고 생각한 구매자가 갈 곳은 **카드사**뿐이다.
// 차지백은 우리가 아무것도 못 하는 자리에서 돈이 빠지는 것이고, 그 전에 우리 안에서
// 끝낼 기회를 스스로 없애는 셈이다. 게다가 분쟁 처리 절차가 없는 플랫폼이라는 사실
// 자체가 소비자 분쟁에서 불리하게 작동한다.
//
// **`Purchase.escrowStatus: DISPUTED`를 재사용하지 않는다.** 그건 **결제 분쟁**
// (차지백 — 돈이 실제로 빠져나간 사건)이고 이건 **판정 분쟁**(돈은 그대로, 판정의
// 정확성을 다툼)이다. 처분이 비슷하다고 한 칸에 담으면 나중에 "차지백인가 판정
// 이의인가"를 쿼리로 구분할 수 없다 — riskLevel에 판정 불가를 섞었다가 되돌린 것과
// 같은 실수다.
//
// **리서처는 이 표를 못 본다.** 보이는 것은 "해당 건이 검토 중이라 정산이 보류됐다"
// 한 줄뿐이다 — 구매자의 인적사항도 제보 내용도 넘기지 않는다. 이 창구가
// 구매자↔리서처 소통 경로로 변질되는 순간 투자자문업 해석 위험이 생긴다.
model JudgmentDispute {
  id         String   @id @default(cuid())
  /**
   * 이의가 걸린 판정도 되돌릴 수 있어야 한다 — 필수 관계였을 때 Prisma 기본
   * 동작(Restrict)이 판정 삭제를 거부해 "인정하고 못 되돌리는" 덫이 됐다.
   * 되돌리면 링크만 끊고 **이의 기록은 남긴다**(지표 ③의 분자이자 분쟁 시 우리 기록).
   */
  judgmentId String?
  judgment   Judgment? @relation(fields: [judgmentId], references: [id], onDelete: SetNull)
  /**
   * 누가 제기했는가 — PURCHASER | RESEARCHER (2026-08-15).
   *
   * **표를 나누지 않은 이유**: 두 쪽의 주장이 같은 종류다 — "판정에 쓰인 데이터가
   * 실제와 다르다". 심판(플랫폼)에게 데이터 오류를 따지는 창구가 청구인마다 따로
   * 있으면 같은 판정에 대한 두 주장이 서로를 모른 채 처리되고, 운영자는 화면 두 개를
   * 오가며 같은 스냅샷을 두 번 대조한다.
   *
   * 갈리는 것은 **처분**이지 사건이 아니다 (judgmentDisputeService 참고).
   */
  actorRole  String   @default("PURCHASER")
  /**
   * 제기한 사람의 구매 — **구매자 이의에만 있다.**
   * 리서처의 주장은 판정 자체에 붙는다(구매가 0건이어도 점수는 깎였다).
   * SQLite의 unique는 NULL을 서로 다르게 보므로 리서처 이의가 여럿이어도 걸리지 않는다.
   */
  purchaseId String?  @unique
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])
  buyerId    String?
  /** 리서처 이의의 제기자 — ResearcherProfile.id */
  researcherId String?
  /**
   * 무엇이 틀렸다고 보는가 — **자유 서술을 받지 않는다.**
   * 열어 두면 "이 리서처 사기꾼이다", "종목 다시 추천해달라"가 들어와 창구의 성격이
   * 바뀐다. 고를 수 있는 것은 전부 **데이터에 관한 주장**이다:
   * PRICE_DATA | CORPORATE_ACTION | TIMING | OTHER_SYSTEM
   */
  category   String
  /** 확인한 실제 값 (예: "8/1 종가 71,200원") — 의견이 아니라 대조할 수치 */
  observed   String?
  /**
   * 맞다고 주장하는 가격 — **리서처 이의에는 필수** (2026-08-15).
   *
   * 남용 방지를 점수 차감이 아니라 **구조**로 한다: 값을 대라고 요구하면
   * "억울하다"는 못 내고 "8/1 종가는 71,200원이다"만 낼 수 있다. 그리고 그 주장은
   * 판정 스냅샷과 **기계적으로 대조**되므로 운영자 시간이 거의 들지 않는다.
   */
  claimedPrice Float?
  status     String   @default("OPEN") // OPEN | UPHELD(인정) | REJECTED(기각)
  resolvedAt DateTime?
  resolvedBy String? // 운영자 userId
  /** 운영자 판단 근거 — 기각이어도 남긴다(같은 유형이 반복되면 진짜 결함이다) */
  resolution String?
  createdAt  DateTime @default(now())

  @@index([status])
  @@index([judgmentId])
}

// 되돌린 판정의 묘비 — **지운 것을 지웠다는 사실까지 지우면 안 된다.**
//
// 판정을 되돌리려면 Judgment 행을 지워야 한다(predictionCardId가 unique라 남겨 두면
// 다시 판정할 수 없다). 그런데 판정은 돈(에스크로)과 점수(규율 래더의 영구 증거)를
// 동시에 움직인 사건이라, 행만 조용히 사라지면 **"왜 이 카드가 두 번 판정됐나"에
// 답할 수 없다.** 그래서 지우기 전에 통째로 여기 옮겨 적는다.
//
// 추가만 하고 고치거나 지우지 않는다 (append-only).
model JudgmentRevert {
  id               String   @id @default(cuid())
  predictionCardId String
  /** 지워진 Judgment의 원래 id — 로그·감사 스냅샷과 이어 붙이는 열쇠 */
  judgmentId       String
  outcome          String
  score            Float?
  info             Float?
  judgedAt         DateTime
  /** 지워진 Judgment 행 전체 (JSON) — 형태가 바뀌어도 그때의 값이 남는다 */
  judgmentJson     String
  /** 함께 지운 Settlement 행들 (JSON 배열) — 금액을 나중에 재현할 수 있어야 한다 */
  settlementsJson  String
  reason           String
  operatorUserId   String
  revertedAt       DateTime @default(now())

  @@index([predictionCardId])
}

// 구매: PG 웹 결제 → 에스크로 보관 → 판정 후 정산
model Purchase {
  id            String   @id @default(cuid())
  reportId      String
  report        Report   @relation(fields: [reportId], references: [id])
  buyerId       String
  buyer         User     @relation(fields: [buyerId], references: [id])
  amountKrw     Int // 결제 총액
  paymentMethod String   @default("CARD") // CARD만 받는다 (VBANK는 차단 전 기록에만 남음 — purchaseService.ACCEPTED_PAYMENT_METHODS)
  paymentInfo   String? // 마스킹된 표시용 결제 정보(카드 끝 4자리). 카드번호 원문은 절대 저장 금지
  // PG 결제 키 — **환불 자동 실행의 열쇠**. 이게 있어야 정산 콘솔이 PG 취소를 직접 부를 수 있다.
  // 스텁 구매·과거 구매에는 없고, 없으면 계좌이체 환불로만 처리한다. 비밀값이 아니다(승인 API가 이미 클라이언트에 노출)
  paymentKey    String?
  // 결제 순간의 가격 방어가 **무엇으로** 통과했는지 (domain/priceGate.ts).
  // LIVE = 실시간 시세로 q를 쟀다 / MARKET_CLOSED = 장이 닫혀 있어 마지막 종가로 쟀다
  // (닫힌 동안 q는 변하지 않으므로 그것이 맞는 값이다) / NO_CARD = 잴 카드가 없다.
  // 분쟁이 나면 "이 결제가 어떤 근거로 승인됐는가"의 답이 여기 있다
  priceGate     String?
  // HELD | SETTLED | REFUNDED | DISPUTED | CANCELLED
  //
  // **넷째와 다섯째가 왜 따로인가** — 앞의 셋은 전부 "정상적으로 끝났다"의 갈래고,
  // 뒤의 둘은 거래가 정상 경로를 벗어난 상태다:
  //  · DISPUTED  — 차지백이 걸렸다. 판정은 카드 단위로 그대로 진행되지만 **이 구매만**
  //                정산·환불에서 빠진다(배치가 HELD만 가져간다). 분쟁이 끝날 때까지
  //                리서처에게도 구매자에게도 돈이 가지 않는다
  //  · CANCELLED — CS 환불로 **거래 자체를 무효화**했다. REFUNDED와 다른 값을 쓰는
  //                이유는 열람 권한 때문이다: 판정 실패 환불(REFUNDED)은 이미 읽고
  //                결과를 기다린 거래라 본문이 남아야 하지만, 무효화는 "산 적 없는 것"이
  //                되어야 한다. 같은 값을 쓰면 결제→열람→즉시 CS환불이 공짜 열람이 된다
  escrowStatus  String   @default("HELD")
  paidAt        DateTime @default(now())
  // 판매 마감 확인 — 마감된 내 카드는 리더보드에 계속 보이다가, 구매자가 확인을
  // 누르면 목록에서 내려간다 (MY 구매 내역에는 계속 남는다)
  salesCloseAckAt DateTime?

  settlement Settlement?
  refundAttempts RefundAttempt[] // CS 환불(판정 전)의 시도 기록 — 판정 환불은 Settlement에 매달린다
  judgmentDispute JudgmentDispute? // 판정 이의 (구매 1건당 1회)
  compensation CompensationInstruction? // 플랫폼 귀책 보상 (판정 못 한 건에 한함)

  @@unique([reportId, buyerId]) // 자기 구매 중복 방지 및 1인 1구매
}

// 정산받을 계좌 — **사람당 하나, 지시서에는 절대 박지 않는다** (2026-08-16).
//
// ── 왜 지시서에 스냅샷을 안 남기나 ──────────────────────────────
// 지시서마다 계좌를 박아 두면 **바꾼 뒤에도 옛 계좌로 나간다.** 두 가지가 동시에 나쁘다:
//  · 계좌를 해지하고 갈아탄 사람에게 보내면 100% 이체 실패다(그 뒤처리가 더 복잡하다)
//  · 탈취를 뒤늦게 알고 정상 계좌로 되돌려도, 이미 찍힌 스냅샷은 그대로 나간다
// 그래서 실행 시점에 **지금 등록된 계좌**를 본다. 지시서는 `userId`·금액·출처만 갖는다.
//
// ── 그러면 반대 위험(탈취 직후 실행)은 무엇이 막나 ──────────────
// **실시간 조회 자체는 아무것도 막지 못한다** — 탈취자가 자기 계좌로 바꾸면 그 계좌로
// 나갈 뿐이다. 막는 것은 **계좌를 바꾸면 즉시 미검증으로 떨어진다**는 규칙이고,
// 미검증에는 한 푼도 안 나간다. 그 위에 두 겹이 더 있다:
//  · **변경 쿨다운** — 바꾼 뒤 일정 시간은 검증돼도 안 내보낸다. 그 사이 본인에게
//    알림이 가므로 "내가 안 바꿨다"고 말할 창이 생긴다
//  · **예금주명 대조** — 은행이 돌려준 이름이 본인 인증 실명과 다르면 VERIFIED가 될 수
//    없다. ⚠ **이 겹은 아직 없다** — 실명을 저장하지 않기 때문이다(개인정보처리방침
//    확정 전). 그때까지 VERIFIED는 "계좌가 실재한다"까지만 뜻한다
/// 기기에 묶인 로그인 열쇠 (패스키 / WebAuthn).
///
/// **왜 두나**: 지금까지 로그인은 매번 본인 인증이었다. 실공급자를 붙이면 그것이
/// **앱을 열 때마다 나가는 비용**이 되고, 사용자에게도 매번 이름·번호를 적게 한다.
/// 패스키는 그 자리를 대신한다 — 지문 한 번, 공짜, 1초.
///
/// **그리고 유일하게 폰 번호와 무관한 관문이다.** 본인 인증도 문자 알림도 번호에
/// 걸려 있어 유심을 가로채이면 함께 무너지는데, 이 열쇠는 기기 안에 있어 남는다.
///
/// ⚠ 생체 정보는 **어디에도 저장되지 않는다.** 지문·얼굴은 기기 밖으로 나오지 않고,
/// 기기가 그것으로 로컬 열쇠를 열어 서명만 만든다. 우리가 보관하는 것은 공개키뿐이라
/// 이 표가 통째로 새어도 남의 계정으로 로그인할 수 없다.
model Passkey {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 인증기가 준 자격증명 ID (base64url). 로그인할 때 이것으로 공개키를 찾는다
  credentialId String @unique
  /// 공개키 (base64url). **비밀이 아니다** — 검증에만 쓰이고 서명은 못 만든다
  publicKey    String
  /// 서명 횟수. 되돌아가면 복제된 인증기라는 신호다(0 고정 기기는 검사하지 않는다)
  counter      Int    @default(0)
  /// 사용자가 알아볼 이름 — "내 아이폰". 어느 기기를 지울지 고르려면 필요하다
  label        String
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

/// 1회용 챌린지. **재사용을 막는 것이 이 표의 존재 이유다** —
/// 같은 서명을 두 번 받아주면 가로챈 서명 하나로 계속 로그인할 수 있다.
model WebAuthnChallenge {
  id        String   @id @default(cuid())
  challenge String   @unique
  /// 등록이면 그 사용자, 로그인이면 아직 누군지 모르므로 null
  userId    String?
  purpose   String // REGISTER | LOGIN
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// 운영자 2인 승인 (Maker-Checker, 2026-08-16 검토 2차 Q3).
///
/// **운영자 계정 탈취는 시스템의 root가 뚫리는 것이다.** 운영자는 정산 동결을 푸는
/// 유일한 사람이고, 판정을 되돌리고, 지급을 실행한다. 패스키와 최근성은 "들어오는 것"을
/// 막지만, 이미 들어온 사람(또는 악의를 품은 내부자)이 **실행하는 것**은 못 막는다.
///
/// 그래서 돈이 크게 움직이는 행위는 **요청과 승인을 다른 사람이** 한다.
/// 요청자가 자기 요청을 승인할 수 없다는 것이 이 표의 전부다.
model OperatorApproval {
  id           String    @id @default(cuid())
  /// 무엇을 하려는가 — domain/operatorApproval.ts의 APPROVAL_ACTIONS
  action       String
  /// 대상 식별자 (settlementId·researcherUserId 등 행위마다 다르다)
  targetId     String
  /// 사람이 읽는 요약 — 승인자가 무엇을 승인하는지 알아야 승인이 의미를 갖는다
  summary      String
  /// 금액이 걸린 행위면 원 단위 (없으면 null)
  amountKrw    Int?
  requestedBy  String
  requestedAt  DateTime  @default(now())
  reason       String
  /// PENDING | APPROVED | REJECTED | EXECUTED
  status       String    @default("PENDING")
  decidedBy    String?
  decidedAt    DateTime?
  /// 만료 임박 재알림을 보낸 시각 (검토 5차 Q3) — 한 번만 울린다. 매일 울리면 배경음이 된다
  remindedAt   DateTime?
  decisionNote String?
  executedAt   DateTime?

  @@index([status, requestedAt])
  @@index([action, targetId])
}

model PayoutAccount {
  id               String   @id @default(cuid())
  /** 사람당 하나 — 여러 개를 허용하면 "어느 것으로 보냈나"가 매번 질문이 된다 */
  researcherUserId String   @unique
  bankCode         String
  /** 암호화 보관 (server/fieldCrypto.ts). 원문은 이체 실행 순간에만 복호화한다 */
  accountNumberEnc String
  /** 화면·감사용 뒤 4자리 — 이것 때문에 전체를 복호화할 이유가 없어진다 */
  accountLast4     String
  /**
   * 예금주명 — **은행 조회 응답으로만 채운다.**
   * 본인에게 입력받으면 양쪽을 다 본인이 적는 것이라 아무것도 대조하지 못한다.
   * 조회 계약 전에는 null로 남고, 그동안 status는 UNVERIFIED다
   */
  holderName       String?
  /**
   * 계좌 등록 시점의 **본인 인증 실명** (암호화 — server/fieldCrypto.ts).
   * 은행이 돌려준 `holderName`과 대조할 상대편이고, 그 대조가 계좌 탈취 방어의 3층이다.
   *
   * **User가 아니라 여기 두는 이유**: 목적이 예금주 대조 하나뿐이라, 계좌가 사라지면
   * 이 값도 함께 사라져야 한다. User에 두면 계좌를 지워도 실명이 남는다.
   *
   * **이력(PayoutAccountHistory)에는 복사하지 않는다.** 같은 사람의 실명은 바뀌지 않아
   * 이력에 남길 정보가 없고, 남기면 개인정보 사본만 계좌 변경 횟수만큼 늘어난다.
   *
   * 해시가 아니라 암호화인 이유: 한국 이름은 조합 수가 적어 **해시가 사실상 평문**이다.
   * (CI 해시가 안전한 것은 CI가 88바이트 난수라서지 해시라서가 아니다)
   */
  verifiedNameEnc  String?
  /** UNVERIFIED | VERIFIED | HOLDER_MISMATCH */
  status           String   @default("UNVERIFIED")
  verifiedAt       DateTime?
  /** 마지막 변경 시각 — 이력·화면 표시용 */
  changedAt        DateTime @default(now())
  /**
   * 이 시각 전에는 지급하지 않는다 (2026-08-16 사용자 확정 — 기기 조건부 쿨다운).
   *
   * **평소 로그인 기기(간편 로그인이 사는 기기)에서 바꾸면 null** — 대기 없이 지급된다.
   * 낯선 기기에서 바꾸면 +48시간. 쿨다운을 모든 변경에 걸었던 처음 설계를 완화한 것:
   * 계좌 변경은 본인 인증 재확인 + 예금주명 대조를 이미 지나므로, 남는 위협은
   * "유심 스와핑 + 본인 명의 통장"뿐인데 그 공격자의 기기는 **낯선 기기**다.
   * 고지가 나가는 경우(낯선 기기)에만 대기도 남긴다 — 고지만 있고 대기가 없으면
   * 이미 지급 가능한 정산이 알림 도착 전에 나가서 동결 버튼이 눌러볼 새가 없다.
   */
  cooldownUntil    DateTime?
  /**
   * 유예 즉시 해제 확인 번호 (2026-08-16 사용자 확정) — 낯선 기기에서 계좌를 바꾸면
   * 생성되고, **그 낯선 기기 화면에 표시된다.** 입력은 평소 로그인 기기에서만 받으므로
   * 번호가 새 기기(탈취자 포함)에 보여도 안전하다 — **번호의 힘은 번호 자체가 아니라
   * "어디서 입력되는가"에 있다.** 평소 기기에서 입력됐다 = 평소 기기를 쥔 본인이 이
   * 변경을 승인했다는 뜻이고, 그건 48시간 침묵보다 강한 증거라 즉시 해제가 정당하다.
   * 평문 저장인 이유: 새 기기가 화면을 다시 열 때 재표시해야 하고, 비밀이 아니라서다.
   */
  cooldownCode     String?
  /** 확인 번호 시도 횟수 — 5회 틀리면 번호가 타고 48시간 대기로 돌아간다 */
  cooldownCodeAttempts Int @default(0)
  /**
   * 동결 — 본인이 "내가 안 바꿨다"고 말한 순간 (2026-08-16).
   *
   * 쿨다운 48시간의 값어치는 기다림 자체가 아니라 **그 사이에 진짜 주인이 멈출 수
   * 있다는 것**이다. 멈출 방법이 없으면 48시간은 그냥 지연이다.
   *
   * ⚠ **거는 것은 누구나, 푸는 것은 운영자만.** 이 비대칭이 장치의 전부다 —
   * 본인이 풀 수 있으면 계정을 쥔 탈취자가 풀 수 있고, 그러면 동결이 아니다.
   * 잘못 건 동결의 대가는 "운영자에게 연락해야 한다"이고, 못 건 동결의 대가는
   * 돈이 나가는 것이다. 비대칭이 옳은 방향으로 서 있다.
   */
  frozenAt         DateTime?
  frozenBy         String?
  createdAt        DateTime @default(now())
}

// 계좌 변경 이력 — **덧붙이기만 한다** (2026-08-16, 외부 검토 D).
//
// PayoutAccount는 덮어쓰는 표라 "언제 어떤 계좌로 바뀌었나"가 남지 않는다. 그 질문은
// 정산 분쟁과 수사 협조에서 반드시 나오고, 그때 없으면 만들 방법이 없다.
// 감사 로그(AuditLog)와 따로 두는 이유: 저쪽은 **사건**의 순서를 남기는 표이고
// 이쪽은 **값**의 이력이다. 계좌번호를 감사 로그 JSON에 넣으면 검색도 안 되고
// 파기 요청이 왔을 때 지울 자리도 흩어진다.
model PayoutAccountHistory {
  id               String   @id @default(cuid())
  researcherUserId String
  bankCode         String
  accountNumberEnc String
  accountLast4     String
  holderName       String?
  status           String
  /** 누가 바꿨나 — 본인이면 userId, 운영자 개입이면 그 운영자 */
  actor            String
  recordedAt       DateTime @default(now())

  @@index([researcherUserId, recordedAt])
}

// 플랫폼 귀책 보상 지시서 — **Settlement과 같은 표를 쓰지 않는다** (2026-08-16).
//
// ── 왜 나누는가 ─────────────────────────────────────────────────
// 두 표가 옮기는 돈의 **출처가 다르다.** Settlement은 구매자가 낸 돈을 나누는
// **위탁 정산**이라 우리 자산이 아니고, 보상은 우리 자본에서 나가는 **손해 보전**이다.
// 한 표에 섞으면 "에스크로 계좌에 있어야 할 돈"과 "회사 계좌에서 빠질 돈"이 같은
// 합계에 들어가, 잔액 대조가 영원히 안 맞는다. 회계상 성격이 다른 돈은 표부터 다르다.
//
// ── 무엇을 공유하는가 ───────────────────────────────────────────
// **이체 실행 레일만** 공유한다 — 일일 출금 한도(payoutVelocity), 감사 로그,
// 은행 이체 참조번호, 운영자 알림. 도메인 규칙은 하나도 공유하지 않는다:
//  · 쿨다운(48시간)   — 판정이 뒤집힐까 봐 기다리는 것인데 **뒤집힐 판정이 없다**
//  · 이의 차단        — 이의는 판정에 거는 것이라 판정 없는 건에는 성립하지 않는다
//  · PG 입금 지연(3일) — 구매자에게 이미 전액 환불했다. 이 돈은 PG를 거치지 않는다
// 규칙을 억지로 공유하면 "왜 이 검사가 여기 있나"에 답할 수 없는 코드가 남는다.
//
// ── 금액 = 판매 대금 − 수수료 ───────────────────────────────────
// 전액으로 하면 **장애가 나면 정상 적중보다 더 번다**(수수료를 안 떼므로). 그 역유인이
// 남으면 언젠가 누군가 그것을 노린다. 우리는 그 건의 수수료 수익을 0으로 처리한다 —
// 계산은 settle({outcome:'HIT'})을 그대로 부르므로 정산 공식과 갈라질 수 없다.
model CompensationInstruction {
  id               String   @id @default(cuid())
  /** 구매 1건 = 보상 1건. 돈은 구매 단위로 움직이고, 차지백 걸린 건만 따로 뺄 수 있다 */
  purchaseId       String   @unique
  purchase         Purchase @relation(fields: [purchaseId], references: [id])
  /** 사건은 카드 단위다 — 한 카드의 여러 구매를 사람이 한 번에 확정한다 */
  predictionCardId String
  /** 받는 사람. 구매를 타고 갈 수 있지만 지급 대상은 생성 시점에 못 박는다 */
  researcherUserId String
  amountKrw        Int
  /** SYSTEM_PAUSE | MANUAL_QUEUE | SYSTEM_ERROR | DATA_UNKNOWN (domain/compensation.ts) */
  cause            String
  /**
   * PENDING_REVIEW | APPROVED | EXCLUDED | EXECUTED
   *
   * **전부 PENDING_REVIEW로 태어난다.** 자동 승인 경로를 두지 않는 이유는 아래 세 가지다:
   *  ① 이 돈이 분 단위로 나가야 할 이유가 없다 — 대상은 이미 시한 후 14~16일 기다린 건이다
   *  ② `SYSTEM_ERROR`(우리 코드가 죽음)는 "우리 귀책이 확실"한 동시에 **시스템을 가장
   *     못 믿을 상태**다. 버그 하나가 카드 200장을 닫으면 보상 200건이 자동 생성된다
   *  ③ 자동 경로가 없으면 **큐 길이 자체가 사고 규모의 계기판**이 된다
   * 예산 초과는 상태로 저장하지 않는다 — 달이 바뀌면 예산은 리셋되는데 행은 스스로
   * 안 풀린다. 한도는 실행 시점의 함수이므로 실행 시점에 계산한다(compensationBudget).
   */
  status           String   @default("PENDING_REVIEW")
  createdAt        DateTime @default(now())

  reviewedAt    DateTime?
  reviewedBy    String? // 운영자 userId
  reviewNote    String?
  executedAt    DateTime?
  executedBy    String?
  /** 계좌이체에는 멱등키가 없다 — 이 번호가 시스템 밖 현금 이동의 유일한 증명이다 */
  bankReference String?

  @@index([status, createdAt])
  @@index([predictionCardId])
}

// 정산: 적중/실패/판정불가 3분기 결과 기록.
// 판정 시점엔 "지시서"(얼마를 환불/지급해야 하는가)가 만들어지고,
// 실제 돈이 움직인 시점은 운영자가 실행 필드로 기록한다 (PG 자동화 전 수동 운영 경로).
model Settlement {
  id                  String   @id @default(cuid())
  purchaseId          String   @unique
  purchase            Purchase @relation(fields: [purchaseId], references: [id])
  outcome             String // HIT | MISS | UNDECIDABLE
  researcherPayoutKrw Int // 리서처 정산액
  platformFeeKrw      Int // 플랫폼 수수료 (판정 불가 시 0)
  buyerRefundKrw      Int // 구매자 환불액 — 항상 현금 (실패: 성과 연동분 / 판정불가: 전액)
  refundType          String? // CASH_REFUND | null. PG 취소/계좌이체 실행의 지시서 역할
  settledAt           DateTime @default(now())

  // 환불 실행 추적 (buyerRefundKrw > 0 건)
  refundMethod     String? // PG_CANCEL | BANK_TRANSFER (취소 기한 초과 건은 계좌이체 폴백)
  refundExecutedAt DateTime?
  refundExecutedBy String? // 실행 운영자 userId
  // 리서처 지급 실행 추적 (researcherPayoutKrw > 0 건)
  payoutExecutedAt DateTime?
  payoutExecutedBy String? // 실행 운영자 userId

  refundAttempts RefundAttempt[]
}

// 환불 시도 1회 — **성공한 것만이 아니라 시도한 것을 전부 남긴다.**
//
// 이 표가 있는 진짜 이유는 감사가 아니라 **멱등키의 기준점**이다. PG 취소는 재시도되는
// 동작인데(응답을 못 받으면 실제로 취소됐는지 알 수 없다) 멱등키를 정산 id로 잡으면
// "같은 정산의 두 번째 취소"가 영원히 불가능해진다 — 토스가 첫 번째 성공 응답을 그대로
// 돌려주므로 **코드는 성공으로 알고 돈은 안 나간다.** 판정 정정으로 추가 환불이 필요한
// 날 조용히 틀린다.
//
// 그래서 시도할 때마다 이 행을 PENDING으로 먼저 만들고, 그 id를 멱등키로 쓴다.
// 같은 시도의 재시도는 한 번만 나가고, 새로운 시도는 새 키를 받는다.
model RefundAttempt {
  id           String     @id @default(cuid())
  /**
   * 어떤 종류의 환불인가 — **금액을 옮기는 절차는 같지만 뜻이 다르다.**
   *  · JUDGMENT_FAIL — 판정이 만든 환불. Settlement에 매달린다
   *  · CS_CANCEL     — 운영자가 거래 자체를 무효화한 환불. 판정 전이라 Settlement이 없다
   * 한 표에 담은 이유: 멱등키가 **시도 id**라(같은 키로 두 번 부르면 한 번만 나간다)
   * 그 성질을 두 벌로 나누면 한쪽에서 조용히 어긋난다. 표를 나누면 환불 실행 로직도
   * 두 벌이 되는데, 돈을 옮기는 코드가 두 벌인 것이 이 시스템에서 가장 위험한 중복이다
   */
  type         String     @default("JUDGMENT_FAIL")
  /** JUDGMENT_FAIL이면 필수 (서비스가 강제한다 — SQLite에 조건부 제약이 없다) */
  settlementId String?
  settlement   Settlement? @relation(fields: [settlementId], references: [id])
  /** CS_CANCEL이면 필수. 판정 전이라 매달 Settlement이 없어 구매를 직접 가리킨다 */
  purchaseId   String?
  purchase     Purchase?  @relation(fields: [purchaseId], references: [id])
  amountKrw    Int // 이 시도가 돌려주려 한 금액 (부분 취소액)
  method       String // PG_CANCEL | BANK_TRANSFER
  status       String     @default("PENDING") // PENDING | SUCCEEDED | FAILED
  error        String? // 실패 사유 (PG 응답 메시지)
  operatorId   String // 실행을 누른 운영자 userId
  createdAt    DateTime   @default(now())
  finishedAt   DateTime?
  // 은행 이체 참조번호 (BANK_TRANSFER 필수) — **계좌이체에는 멱등키가 없다.**
  // PG 취소는 같은 키로 다시 불러도 한 번만 나가지만, 사람이 은행 앱에서 보내는 돈은
  // 시스템이 막을 방법이 없다. 시스템 바깥에서 일어난 현금 이동을 안으로 증명하는
  // 유일한 수단이 이 번호다 — 재시도 화면이 이걸 물으면 운영자가 은행 앱을 다시 보게 된다
  bankReference String?
  // 방치 알림을 보낸 시각 — 같은 건을 매 회차 다시 알리면 소음이 되어 아무도 안 읽는다
  escalatedAt   DateTime?

  @@unique([settlementId, bankReference]) // 같은 이체를 두 번 기록할 수 없다
  @@index([settlementId])
  @@index([purchaseId])
}

// 컴플라이언스 검수: 게시 시도마다 남는 기록.
// 차단된 시도도 보존한다 — 반복 위반 패턴이 어뷰징 탐지 근거가 되기 때문.
model ComplianceReview {
  id                  String    @id @default(cuid())
  reportId            String
  report              Report    @relation(fields: [reportId], references: [id])
  decision            String // PASS | WARN | BLOCK | UNAVAILABLE
  reviewer            String // 검수 주체 (rule | rule+claude:모델명)
  findingsJson        String // Finding[] 직렬화 (감사·리서처 안내용)
  needsOperatorReview Boolean   @default(false)
  operatorReviewedAt  DateTime? // 운영자가 확인한 시각
  // 대기가 길어져 운영자에게 다시 알린 시각 — 하루에 한 번만 재알림하기 위한 중복 방지
  escalatedAt         DateTime?
  operatorReviewedBy  String? // 확인한 운영자 userId
  /// 수동 2차 질문지를 **뽑은** 시각 (18차 V-7).
  ///
  /// 재는 이유는 하나다: 큐가 밀리면 운영자가 **안 물어보고 그냥 승인**한다. 라벨은
  /// 남는데 근거가 없고, 그 라벨이 학습셋에 섞인다. **이 고장은 조용히 일어나서**
  /// 결과만 보면 정상 운영과 구별되지 않는다. 뽑은 시각이 없는 판정의 비율이
  /// 그 침묵을 소리로 바꾼다 (complianceOpsService: 교사 질의 누락률).
  teacherAskedAt      DateTime?
  // ── 운영자 판정(정답 라벨) ─────────────────────────────────────────
  // 검수가 맞았는지는 사람의 최종 결정으로만 알 수 있다. 이 네 칸이 없으면
  // 오탐률·미탐률을 측정할 수 없고, 규칙·프롬프트·모델을 근거 있게 바꿀 수 없다.
  operatorVerdict     String? // APPROVED | REJECTED | KEPT | TAKEDOWN (screeningAccuracy.ts)
  operatorReason      String? // 반려·철회 사유 (오탐 사례 되먹임의 설명)
  // 운영자가 지목한 실제 위반 유형 JSON — 비었으면 "검수 소견 그대로 인정"
  operatorCategories  String?
  // 승인 시: 지적 자체는 타당했는가 (경미해서 승인한 것과 오탐을 구분)
  aiFindingsValid     Boolean?
  // AI 검수 토큰 사용량 — 실제 비용 측정 + 숙고량 신호 (규칙만 돌았으면 null).
  // 이 데이터가 쌓이면 ① 모델 선택 ② 에스컬레이션 임계값을 근거 있게 정할 수 있다.
  inputTokens         Int?
  outputTokens        Int?
  deliberationRatio   Float? // outputTokens / inputTokens — 리포트 길이 정규화한 고민 지표
  /// 학생 결석의 꼬리표 (21차 Y-1(b) · 관리자 앱 2회차 B-2).
  ///
  /// null = 학생이 정상 참여했거나 애초에 꺼져 있었다(의도된 끔).
  /// 'OUTAGE_HOLD'  = 라이브 장애로 보류된 건 (Q0 정책)
  /// 'VALVE_BYPASS' = 운영자가 밸브를 내려 학생 없이 흘러간 건
  ///
  /// 왜 꼬리표인가 — "학생 소견 0건(정상)"과 "학생 결석(장애·우회)"은 결과값이
  /// 같다. 이 칸이 없으면 훗날 미탐률을 잴 때 장애로 뚫린 건을 학생이 못 잡은
  /// 건으로 오인해 지표가 오염된다 (21차 gap 17형 함정 지적)
  studentAbsence      String?
  /// 운영자가 이 건을 **열람하고 판정하기까지** 걸린 시간 (관리자 화면이 재서 보냄).
  ///
  /// 26차 CC-1 반증 조건 — 라이브 유지의 대가는 오탐 흡수인데, 오탐이 잦은 유형
  /// (SCREENING_EVASION·CARD_MISMATCH)의 판단 시간이 다른 유형의 절반 밑으로
  /// 떨어지면 운영자가 "아 또 이거네"로 안 읽고 승인하는 피로도 함정이다.
  /// 오탐과 정상 승인이 같은 클릭으로 끝나는 화면에서, 이 시간이 유일한 감별 신호다.
  decisionElapsedMs   Int?
  createdAt           DateTime  @default(now())
  /// 그림자 모드 판정 (처리에 관여하지 않는다 — ShadowComplianceReview 주석 참고)
  shadowReviews       ShadowComplianceReview[]
  /// 수동 2차의 교사 답 (처리 권한 없음 — TeacherAnswer 주석 참고)
  teacherAnswer       TeacherAnswer?

  @@index([reportId])
  @@index([needsOperatorReview, operatorReviewedAt])
}

/// 수동 2차 검수의 **교사 답** — 권한 없는 판정의 보관처.
///
/// ── 왜 ComplianceReview 에 칸을 더하지 않는가 ─────────────────────────
/// ShadowComplianceReview 와 **같은 이유**다. 같은 행에 두면 언젠가 집계 쿼리의
/// WHERE 하나가 빠져 **교사 답이 운영자 판정과 합쳐진다.** 그 순간 정확도 지표가
/// 자기 자신을 재게 되고, 교사 품질 지표(불일치율)가 통째로 죽는다.
/// 실수를 조심하는 대신 구조적으로 불가능하게 만든다 — 기존 집계는 이 표를 모른다.
///
/// ── 순서가 이 표의 값어치를 만든다 (18차 V-3) ────────────────────────
/// **운영자 판정이 먼저 기록된 뒤에만 이 행이 생긴다.** 순서가 뒤집히면 운영자가
/// 교사 답을 보고 고른 것이 되어 두 값이 독립이 아니고, 그러면 불일치율은
/// "교사가 정확하다"와 "운영자가 안 봤다"를 못 가른다.
/// 코드가 그 순서를 강제한다 (teacherAnswerService.recordTeacherAnswer).
model TeacherAnswer {
  id                 String           @id @default(cuid())
  /// 한 검수 건에 한 답 — 두 번 물어봤으면 마지막 답으로 덮어쓴다
  complianceReviewId String           @unique
  /// 어느 교사인가. 대화창 모델은 버전이 오르는데, 표식이 없으면 나중에
  /// "이 라벨은 어느 교사가 만들었나"를 영원히 못 가른다 (18차 V-4)
  teacherTag         String
  /// 교사가 지목한 유형 — StudentLabel[] 직렬화. 빈 배열이면 "위반 없음"
  labelsJson         String
  /// 위반 없음일 때만: 1차 지적 **자체**가 타당했는가.
  /// 타당 = 경미(심각도 문제) · 과함 = 오탐(규칙 문제) — 접으면 학생이 영구히 꺼진다(11차 K-1)
  findingsValid      Boolean?
  /// 운영자가 붙여 넣은 답 원문. 파싱이 틀렸을 때 되짚을 **유일한** 증거다
  rawAnswer          String
  /// 운영자가 **먼저** 고른 판정과 갈렸는가.
  /// 교정 사례는 이 값이 true 인 건에서만 뽑는다 — 교사가 맞힌 것을 다시 먹이는 것은
  /// 의미가 없고, **틀린 것을 사람이 고친 기록**만 교사를 개선한다 (18차 V-5)
  disagreed          Boolean
  /// 답을 옮겨 적은 운영자
  recordedBy         String
  createdAt          DateTime         @default(now())
  complianceReview   ComplianceReview @relation(fields: [complianceReviewId], references: [id], onDelete: Cascade)

  @@index([disagreed, createdAt])
  @@index([teacherTag, createdAt])
}

/// 그림자 모드 판정 — **처리 권한이 없는 판정**의 유일한 보관처.
///
/// ComplianceReview에 칸을 더하지 않고 표를 나눈 이유 (5차 검토 F-2):
/// 같은 행에 두면 언젠가 집계 쿼리의 WHERE 하나가 빠져 **그림자 소견이 실집행 소견에
/// 합쳐진다.** 정확도 지표가 오염되면 이 스레드의 모든 채택 판단이 함께 틀리므로,
/// 실수를 조심하는 대신 구조적으로 불가능하게 만든다 — 기존 집계는 이 표를 모른다.
/// ("자동 만료는 operatorVerdict를 남기지 않는다"와 같은 계열의 방어다.)
///
/// **행동한 판정과 도메인 자체가 다르다**: 이쪽은 아무것도 처리하지 않았고,
/// 리서처에게 안내되지도 않는다. 오직 실집행 판정과 대조해 일치율을 재기 위해서만 있다.
model ShadowComplianceReview {
  id                 String           @id @default(cuid())
  complianceReviewId String
  /// 판정 주체 — 예: student:koelectra-v1@t0.42 (모델·임계값까지 박는다.
  /// 임계값이 다르면 다른 판정기이고, 나중에 어느 설정의 기록인지 못 가리면 비교가 무의미해진다)
  reviewer           String
  /// 학생 소견 Finding[] 직렬화. 여기 있는 것은 어떤 경로로도 리서처에게 나가지 않는다
  findingsJson       String
  /// 추론 지연(ms) — 졸업 조건 ③(p99·이상점)의 원천
  latencyMs          Int?
  createdAt          DateTime         @default(now())
  complianceReview   ComplianceReview @relation(fields: [complianceReviewId], references: [id], onDelete: Cascade)

  @@index([complianceReviewId])
  @@index([reviewer, createdAt])
}

// 학습 표현 사전: 운영자가 반려하면서 "다음부터는 작성 단계에서 걸러라"고 등록한 표현.
// 코드에 박힌 정규식과 달리 운영 중에 늘어난다 — 검수의 커버리지가 시간이 지날수록
// 넓어지는 유일한 경로다. 심각도는 항상 WARN(보류)이며 즉시 거절 권한은 주지 않는다.
model LearnedPhrase {
  id             String    @id @default(cuid())
  phrase         String // 운영자가 입력한 원문 (화면 표시용)
  normalized     String // 매칭용 정규화본 (공백·구분기호 제거)
  category       String // RiskCategory
  note           String? // 리서처에게 보여줄 설명
  active         Boolean   @default(true)
  createdBy      String // 등록한 운영자 userId
  sourceReportId String? // 어느 반려 건에서 나왔는가 (감사)
  // 사전은 방치하면 썩는다 — 표현별 정확도를 재서 오탐 항목을 걷어낸다
  matchCount     Int       @default(0) // 이 표현이 걸린 게시 시도 수
  confirmedCount Int       @default(0) // 그중 실제 반려·철회로 확정된 수
  lastMatchedAt  DateTime?
  createdAt      DateTime  @default(now())
  // 의미 검색용 임베딩 벡터 (semanticIndex.ts). 등록 시 한 번 계산해 저장한다 —
  // 검수마다 사전 전체를 다시 임베딩하면 비용이 사전 크기에 비례해 늘어난다.
  // ⚠ 의미 검색은 20차에 검수 배선에서 끊겼다 — 컬럼은 창업자 지시로 보존
  vectorJson     String?
  // 이 벡터를 만든 모델 식별자. 모델이 바뀌면 좌표계가 달라 비교가 무의미해지므로,
  // 현재 모델과 다른 벡터는 인덱스에서 제외하고 재계산 대상으로 본다
  vectorModel    String?
  /// 음성 변형 층(5층) 참여 자격 (20차 X-1) — 등록 시 충돌 검사의 결과.
  /// 근사 매칭은 표현의 자모 거리-1 이웃까지 삼키므로, 그 이웃이 정상 낱말이면
  /// (`수익보장`→`수익보전`) 이 값이 false 로 남고 그 항목은 1~3층만 탄다.
  /// 기본 false — 검사를 안 거친 항목(기존 데이터)에 근사 권한을 주지 않는다
  phoneticEligible Boolean @default(false)
  /// 5층 상한 밀어내기 면제 (22차 Y-2) — matchCount 0 은 "무효한 패턴"과 "1년에 한 번
  /// 필요한 계절성 패턴"(연말정산·테마주 유행)에서 같은 값이라(gap 17형), 무실적
  /// 최고령 밀어내기가 희소하지만 치명적인 방어선을 조용히 지울 수 있다. 운영자가
  /// 체크하면 밀어내기에서 빠진다. 상한 200의 10%(20개)까지만 — 전부 면제면 상한이 없다
  capExempt        Boolean @default(false)
  /// 졸업 시각 (21차 Y-3) — 졸업 직후 7일 관찰 창의 기준점.
  /// active=false 만으로는 "졸업"과 "수동 비활성화(오탐 항목)"를 못 가른다
  graduatedAt      DateTime?

  @@index([active])
}

/// 사전 항목 매칭 이벤트 (관리자 앱 인계서 2026-08-22 §1 → 회신 8호 (나)).
///
/// LearnedPhrase.matchCount 는 숫자만 올려 **누가** 걸렸는지 남기지 않았다. 코드 규칙
/// 후보 조건의 넷째("서로 다른 리서처 ≥ 5명")는 그 사실 없이는 셀 수 없고, 셀 수 없는
/// 조건을 적어 두는 것은 조건이 없는 것보다 나쁘다(있는 것처럼 보인다). 한 사람이 같은
/// 문구를 30번 써서 만든 30회가 후보로 뜨는 것을 이 표가 막는다.
/// 덤으로 "언제 누구에게 걸렸나"에 답한다 — 표현의 정확도가 한 리서처의 습관인지
/// 플랫폼 전체의 패턴인지 갈라 보는 유일한 자료.
model LearnedPhraseHit {
  id           String   @id @default(cuid())
  phraseId     String
  reportId     String
  researcherId String
  createdAt    DateTime @default(now())

  @@index([phraseId, researcherId])
  @@index([reportId])
}

/// 졸업 회귀 시험셋 (20차 X-5) — 사전 항목을 끌 때 운영자가 남기는 대비쌍.
///
/// **졸업은 자동 증명이 아니라 사람의 판단이다.** 변형을 자동 생성해 학생에 넣어 보는
/// 방식은 동어반복이다(생성기가 규칙 6층과 같은 논리면 규칙이 이미 잡는 것만 시험한다).
/// 대신 운영자가 그 표현이 든 **위반 3문장 + 정상 3문장**을 직접 써서 여기 남긴다.
///
/// 이 표는 **영구**다 — 이후 모든 재학습에서 학생이 이 문장들을 통과해야 채택된다.
/// 오답이 나면 릴리스를 막는다(치명적 망각 방어). 학습셋과의 격리는 절대적이다:
/// 여기 문장은 어떤 경로로도 학습 자료로 나가면 안 된다 (17차 채점지 원칙).
model RegressionCase {
  id        String   @id @default(cuid())
  /// 어느 사전 항목의 졸업에서 나왔나
  phraseId  String
  text      String
  /// 이 문장은 위반이어야 하는가 — false 면 학생이 잡으면 안 되는 정상 대비쌍
  expectViolation Boolean
  /// 위반 쪽만: 기대 유형
  category  String?
  createdBy String
  createdAt DateTime @default(now())
  /// 격리 (21차 Y-3) — 삭제가 아니라 격리다. 수정은 영구 금지지만, 잘못 쓴 문항을
  /// 영원히 띄울 수는 없다. 격리는 **운영자 2인 승인**을 소모해야 가능하다 —
  /// 릴리스 압박 속 "학생이 틀리는 문항 지우기" 유혹을 혼자서는 못 누르게 한다
  quarantinedAt    DateTime?
  quarantinedBy    String?
  quarantineReason String?
  /// 게이트 실패 이력 (관리자 앱 4회차 §3) — 격리 판단의 유일한 근거 자료.
  /// "여러 모델에서 반복 실패(문항이 잘못 씀 — 격리 후보)"와 "이번 모델만 실패
  /// (모델이 못 배움 — 격리 금지, 재학습할 것)"를 가른다.
  /// gateFailCount 는 **서로 다른 모델 지문에서의 실패 횟수**다 — lastGateFailSha 와
  /// 다른 지문으로 떨어질 때만 오른다 (같은 모델 두 번은 증거가 두 배가 아니다)
  lastGateFailAt   DateTime?
  lastGateFailSha  String?
  gateFailCount    Int       @default(0)

  @@index([phraseId])
}

/// 졸업 관찰 큐 (21차 Y-3) — 졸업 직후 7일간 그 표현의 규칙 판정을 미러링한다.
///
/// 졸업 직후가 가장 위험한 순간이다 — 사전 보호가 꺼지고 학생만 남는데, 뚫린 것을
/// 알아채는 경로가 미탐 신고뿐이면 운영자가 자기 오류를 자기가 발견해야 한다.
/// 그래서 졸업한 표현은 7일간 규칙으로 계속 돌되(소견은 내지 않는다 — 감시 전용),
/// 걸리면 여기 기록되어 관찰 화면에 뜬다. 학생이 같은 유형을 잡았는지가 함께 남는다.
model GraduationWatchHit {
  id                 String   @id @default(cuid())
  phraseId           String
  complianceReviewId String
  category           String
  /// 같은 건에서 학생도 같은 유형을 냈는가 — false 가 쌓이면 졸업이 성급했다는 증거다
  studentFlagged     Boolean
  createdAt          DateTime @default(now())

  @@index([phraseId, createdAt])
}

// 약관 동의 이력: 누가·언제·어느 문서 버전에·어떤 맥락에서 동의했는지 기록.
// 법적 결론과 무관하게 필요한 감사 데이터 — PG 심사·분쟁 대응의 증빙이 된다.
model Consent {
  id       String   @id @default(cuid())
  userId   String
  docKey   String // TERMS_OF_SERVICE | PRIVACY_POLICY | RESEARCHER_AGREEMENT | REFUND_POLICY
  version  String // 동의 시점의 문서 버전 (legalDocs.ts)
  context  String // SIGNUP | RESEARCHER_ACTIVATION | PURCHASE
  note     String? // 맥락 부가정보 (예: PURCHASE의 reportId)
  agreedAt DateTime @default(now())

  @@index([userId, docKey])
}

// 인앱 알림: 판정·정산 결과를 구매자/리서처에게 통지 (판정 트랜잭션에서 함께 생성)
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // JUDGMENT_RESULT (확장: SETTLEMENT, SEASON 등)
  title     String
  body      String
  link      String? // 클릭 시 이동 경로 (예: /report/xxx)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  // 푸시로 내보낸 시각. **알림 생성은 판정 트랜잭션 안에서 일어나고 I/O는 금지**라
  // (noIoInTransaction) 그 자리에서 푸시를 보낼 수 없다. 대신 이 칸을 비워 두면
  // 스윕이 주워 간다 — 새 알림 종류가 생겨도 자동으로 따라오므로 **잊을 수가 없다**.
  // 호출처 19곳에 발송을 하나씩 심는 방식이었다면 다음에 알림을 추가하는 사람이 빠뜨린다
  pushedAt  DateTime?

  @@index([userId, readAt])
  @@index([userId, createdAt])
  // 스윕이 "아직 안 보낸 것"만 훑는다 — 알림 표는 계속 자라므로 인덱스 없이는 전체 스캔
  @@index([pushedAt, createdAt])
}

// 푸시 구독: 한 사람이 여러 기기를 쓴다 (폰 + 예비 기기 + 웹).
//
// **토큰이 주키가 아니라 유일값인 이유**: 같은 기기가 앱을 지웠다 깔면 새 토큰을 받고,
// 토큰은 공급자가 언제든 갱신한다. 사람↔기기가 아니라 사람↔토큰으로 두고,
// 죽은 토큰은 발송이 알려 줄 때 지운다 (아래 failCount).
model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  platform   String // 'ios' | 'android' | 'web'
  token      String   @unique // FCM 등록 토큰 (웹 푸시도 FCM을 거치면 같은 모양)
  // 기기 이름을 사람이 알아볼 수 있게 — 설정 화면에서 "이 기기 알림 끄기"를 고르려면 필요
  label      String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  // 연속 실패 횟수. 공급자가 "이 토큰은 죽었다"고 말하면 즉시 지우지만, 일시 장애와
  // 진짜 죽음이 구별되지 않는 응답도 있어 몇 번 참았다가 지운다
  failCount  Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 등급 이력: 분기 시즌제 재산정·강등 기록
model TierHistory {
  id           String            @id @default(cuid())
  researcherId String
  researcher   ResearcherProfile @relation(fields: [researcherId], references: [id])
  season       String // 예: "2026-Q3"
  fromTier     String
  toTier       String
  reason       String // PROMOTION | DEMOTION | SEASON_RESET
  createdAt    DateTime          @default(now())
}

// 장바구니 — 담아두고 한 번에 결제하기 위한 대기 목록.
// 결제 전 상태이므로 금액을 저장하지 않는다: 가격은 항상 Report에서 읽어
// 결제 시점 가격으로 청구된다(담은 뒤 가격이 바뀌어도 어긋나지 않는다).
model CartItem {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  reportId String
  report   Report   @relation(fields: [reportId], references: [id])
  addedAt  DateTime @default(now())

  @@unique([userId, reportId]) // 같은 리포트 중복 담기 방지
  @@index([userId])
}

// 토스페이먼츠 결제 요청 — 결제창을 띄우기 전에 orderId·금액을 서버에 먼저 기록해둔다.
// 승인(confirm) 시점에 이 값과 PG 응답을 대조해 클라이언트의 금액 조작을 막는다
// (토스페이먼츠 연동 가이드가 명시하는 필수 절차).
model PaymentIntent {
  id        String   @id @default(cuid())
  orderId   String   @unique // 토스페이먼츠 orderId (6~64자)
  buyerId   String
  buyer     User     @relation(fields: [buyerId], references: [id])
  // 결제할 리포트 **목록의 스냅샷** — `[{ "reportId": "...", "priceKrw": 10000 }, ...]`.
  //
  // 단수 reportId였던 것을 목록으로 바꿨다. 장바구니는 N건 합산을 한 번에 승인하는데,
  // 그보다 중요한 이유는 **결제창을 여는 사이에 장바구니가 바뀔 수 있다는 것**이다
  // (다른 탭에서 담거나 뺌). 승인 후 장바구니를 다시 읽으면 승인 금액과 실제 구매가
  // 어긋난다. 의도를 만드는 순간의 목록을 통째로 박아두고 승인 후에는 이것만 본다.
  itemsJson String
  amountKrw Int
  /**
   * 이 시각이 지나면 승인하지 않는다 (paymentIntentService.INTENT_TTL_MS).
   * createdAt으로 재지 않는 이유: createdAt은 DB가 찍는 벽시계라 "언제까지 유효한가"를
   * 코드가 정하지 못한다 — 만료 규칙은 만들 때 확정해 값으로 박아 두는 것이 맞다.
   * null은 이 규칙이 생기기 전에 만들어진 행이다(만료 없음).
   */
  expiresAt DateTime?
  // PENDING            승인 전 (유효기간 INTENT_TTL_MS — 지나면 배치가 지운다)
  // EXPIRED            유효기간이 지난 뒤 승인을 시도했다 — 돈이 빠지지 않았다
  // CONFIRMED          승인 + 구매 생성 완료
  // FAILED             승인 전에 막힘 (금액 불일치 등) — 돈이 빠지지 않았다
  // CANCELLED          승인은 됐으나 구매 생성이 실패해 **자동 취소됨**
  // REQUIRES_MANUAL_VOID  자동 취소마저 실패 — **PG에 돈이 잡혀 있다. 사람이 취소해야 한다**
  //
  // ⚠ PENDING·EXPIRED만 정리 대상이다. 나머지는 전부 돈이 움직인 흔적이라 지우면
  //   분쟁에서 우리 쪽 근거가 사라진다 (paymentIntentService.purgeExpiredPaymentIntents)
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  @@index([buyerId])
}

// 클린 리서치 신고 — 1:1 상담·투자 권유 등 유사투자자문업 범위 초과 행위 신고.
// 보상(리포트 구매 쿠폰)은 운영자 검토로 확인된 신고에만, 선착순 쿼터 안에서 지급.
//
// **reportId가 이 표의 축이 됐다 (2026-08-19).** 그전까지 신고는 `targetName` 자유 텍스트로만
// 들어왔고 `reportId`는 "링크를 아는 경우"의 선택 항목이라 아무도 채우지 않았다. 그래서
// 같은 리포트를 셋이 신고해도 `밸류헌터` / `밸류헌터님` / `2차전지 리포트`로 각각 들어와
// **시스템도 운영자도 그것이 한 건인 줄 몰랐다** — 같은 위반을 세 번 따로 읽었다.
// 리포트 화면의 신고 버튼이 id를 실어 보내면서 두 가지가 가능해진다:
// 중복 고지("이미 신고된 리포트입니다")와 **서로 다른 신고자 누적에 의한 가역적 판매 중단**.
model AbuseReport {
  id         String    @id @default(cuid())
  reporterId String // 신고자 (User.id)
  reportId   String? // 신고 대상 리포트 — 리포트 화면에서 신고하면 채워진다
  targetName String // 대상 리서처 필명 또는 리포트 제목
  category   String // ONE_ON_ONE / SOLICIT / OUTSIDE_CHANNEL / OTHER
  detail     String // 신고 내용 (정황·근거)
  status     String    @default("PENDING") // PENDING / CONFIRMED / REJECTED
  rewarded   Boolean   @default(false) // 확인 + 선착순 쿼터 내 → 쿠폰 지급 대상
  /// 보상을 **개별로 안내한 시각**. 쿠폰 시스템이 없어 지급은 손으로 하는데,
  /// 이 칸이 없으면 "안내 대기" 목록에서 나갈 방법이 없어 **큐가 영영 안 줄어든다**
  /// (실제로 그랬다). 안내 여부는 지급 여부가 아니다 — 쿠폰이 생기면 이 목록으로
  /// 소급 발행하므로 `rewarded`는 그대로 둔다.
  rewardNoticedAt DateTime?
  reviewedAt DateTime?
  reviewerId String? // 검토 운영자 (User.id)
  reviewNote String? // 확인·기각 사유 (반복 무고 제재 근거로도 사용)
  createdAt  DateTime  @default(now())

  @@unique([reporterId, reportId])
  @@index([status, createdAt])
  @@index([reporterId, createdAt])
  @@index([reportId, status])
}

/// **돈의 근거가 언제 어떻게 바뀌었는지의 단일 기록** (2026-08-15).
///
/// 도메인 표(Settlement·Judgment·ComplianceReview…)는 **상태**를 관리하고, 이 표는
/// **사건**을 남긴다. 둘은 역할이 다르므로 중복은 비용이 아니라 정합성 검증의 재료다 —
/// 어긋나는 날이 오면 그 자체가 시스템 이상 신호다.
///
/// 규칙 셋:
///  ① **append-only** — 갱신·삭제하지 않는다. 지울 수 있는 기록은 증명이 못 된다
///  ② **사건 하나에 한 줄** — 판정 한 번이 정산 3건·알림 3건을 만들어도 로그는 한 줄이다.
///     "정산 s_1이 왜 생겼나"는 도메인 외래키를 타고 올라와 targetId로 조회한다
///     (하위 id를 JSON에 담으면 SQLite에는 JSON 인덱스가 없어 풀스캔이 된다)
///  ③ **인프라 오류는 넣지 않는다** — 그건 로그의 일이고, 섞으면 이 표가 검색되지 않는
///     크기로 자란다. 여기 들어오는 것은 **돈이 움직였거나 돈의 근거가 바뀐 사건**뿐이다
model AuditLog {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  /// 누가 — 운영자 userId 또는 "system:batch:judge" 같은 자동 주체
  actor      String
  /// OPERATOR | SYSTEM | USER — actor 문자열을 파싱하지 않고 종류를 따로 둔다
  actorType  String
  /// 무엇을 했나 (JUDGMENT_CREATED, PAYOUT_EXECUTED, JUDGMENT_REVERTED …)
  action     String
  /// 무엇에 대해 — 도메인 외래키가 이 값을 가리킨다
  targetType String
  targetId   String
  /// 바뀌기 전/후의 **핵심 상태 필드만** (JSON). 객체 트리를 통째로 담지 않는다 —
  /// 감사가 요구하는 것은 "주체·시각·바뀐 상태값"이지 10KB짜리 스냅샷이 아니다
  before     String?
  after      String?
  /// 사람이 남긴 사유 (되돌리기 사유, 이의 판단 근거 등)
  reason     String?

  @@index([targetType, targetId])
  @@index([at])
  @@index([actor])
}

/// 종이 열쇠(오프라인 서명)로 비상 복구를 쓴 기록 (2026-08-17 검토 7차 Q1).
///
/// **nonce가 기본키인 것이 곧 재사용 차단이다.** 표를 한 번 쓰면 이 표에 행이 생기고,
/// 같은 표를 다시 내밀면 유니크 제약에 걸려 두 번째가 실패한다 — 조회 후 삽입으로
/// 나누면 동시에 낸 두 요청이 둘 다 통과한다(승인서·재확인 표와 같은 이유).
///
/// 지우지 않는다. 이 표가 비어 있다는 것 자체가 "종이 열쇠는 한 번도 안 쓰였다"는
/// 증명이고, 그 증명이 분쟁에서 요구받는 값이다.
model RecoveryUse {
  nonce        String   @id
  usedAt       DateTime @default(now())
  targetUserId String
  /// 서명한 사람이 표에 적어 둔 사유 (왜 금고를 열었나)
  note         String?
}

// 이용자 문의 — **주제를 먼저 고르게 하는 창구** (2026-08-18 사용자 확정).
//
// 자유 입력 채팅을 만들지 않은 이유는 domain/supportTopics.ts 머리 주석에 있다:
// 열어 두면 투자 질문이 들어오고, 답하면 1:1 투자자문이라 라이선스 영역이다.
//
// `desk`를 행에 박아 두는 이유: 주제→화면 대응이 나중에 바뀌어도 **이미 접수된 건은
// 접수 당시의 자리에 그대로 남아야** 한다. 계산으로 매번 구하면 규칙을 고치는 순간
// 처리 중이던 문의가 다른 화면으로 옮겨 가 담당이 사라진다.
model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  topic     String // domain/supportTopics.ts의 SupportTopic
  desk      String // 'security' | 'money' | 'report' — 접수 시점의 대응을 고정
  detail    String
  status    String   @default("OPEN") // OPEN | ANSWERED | CLOSED
  /** 운영자가 남긴 답변 — 이용자 알림으로도 나간다 */
  answer    String?
  answeredAt DateTime?
  answeredBy String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([desk, status])
}

// 운영자 공지 — **관리자가 이용자에게 먼저 말하는 유일한 통로** (2026-08-19).
//
// 지금까지 알림은 전부 사건이 만들었다(판정·정산·답변). 운영자가 스스로 꺼낼 말은
// 어디에도 없어서, 점검·규칙 변경·판정 정지를 알릴 방법이 없었다.
//
// **보낸 기록을 따로 남기는 이유**: 알림 행만 만들면 "무엇을 언제 누구에게 보냈나"에
// 답하려고 수천 행을 뒤져 제목으로 묶어야 한다. 발송은 되돌릴 수 없는 행위라
// 그 사실 자체가 한 줄로 남아야 한다.
model Notice {
  id       String   @id @default(cuid())
  title    String
  body     String
  /// 받는 범위 — domain/notice.ts의 NoticeAudience (ALL | RESEARCHER)
  audience String
  /// 실제로 만들어진 알림 수. **보낸 순간의 사실**이라 나중에 다시 세면 달라진다
  /// (그 사이 가입·탈퇴가 일어난다) — 그래서 세지 않고 적어 둔다
  recipients Int
  sentBy   String
  sentAt   DateTime @default(now())

  @@index([sentAt])
}
