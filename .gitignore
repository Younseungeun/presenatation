# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma dev database
prisma/dev.db*

# DB 백업 (npm run db:backup) — 실서비스 데이터가 들어 있으므로 절대 커밋하지 않는다
/backups

# pm2 로그
/logs
.pm2

# 사고 리허설의 일회용 DB (npm run drill) — 매 실행마다 새로 만든다
prisma/drill.db*

# 맥락 이월 실험의 생성물 (18차 V-6) — `npm run probe:bleed` 이 언제든 다시 만든다.
# 2.3MB 이고 규정문이 140번 복제된 것이라 저장소에 둘 이유가 없다.
# **답(answers-*.jsonl)은 다르다** — 사람이 손으로 모은 것이라 잃으면 다시 못 만든다
/training/bleed/condition-a-fresh.json
/training/bleed/condition-b-sequential.md
/training/bleed/answer-key.json

# 사이드카 파이썬 가상환경 (993MB) — requirements.txt 로 다시 만든다
/sidecar/.venv

# 학생 모델 베이스 가중치 (HF 에서 받는 것, 55MB+) — 저장소에 두지 않는다
/local_models

# 그림자 검수 실험용 일회성 DB
shadow-abuse.db

# 파이썬 바이트코드
__pycache__/
